APP_NAME=PANDU PORPROV
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
# Paksa redirect HTTP->HTTPS + HSTS meski APP_ENV=local (mis. artisan serve + ngrok).
# Biarkan false untuk development HTTP murni (http://localhost).
# Kosongkan (=auto) agar mengikuti APP_URL: https:// = true, http:// = false.
FORCE_HTTPS=true

# HSTS — hanya bermakna di HTTPS. preload default mati (lihat config/security.php).
HSTS_ENABLED=true
HSTS_MAX_AGE=63072000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# CSP report-only (tidak memblokir). true = fase uji 1-2 hari; WAJIB false sebelum scan ulang.
CSP_REPORT_ONLY=false
# Host gambar pihak ketiga tambahan, dipisah koma. Default: thumbnail berita/kesehatan (unsplash).
# Kosongkan hanya bila semua gambar sudah self-host ke /images.
CSP_EXTRA_IMG_HOSTS=https://images.unsplash.com

# Proxy terpercaya untuk X-Forwarded-*. '*' dibutuhkan untuk ngrok free.
TRUSTED_PROXIES=*
# Host yang diterima (Host validation). Kosong = semua (ngrok acak OK); produksi: isi domain asli.
# TRUSTED_HOSTS=example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
